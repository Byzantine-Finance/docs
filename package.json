{
  "name": "@byzantine-finance/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "openapi:sync": "node scripts/sync-openapi.mjs",
    "openapi:check": "node scripts/analyze-openapi.mjs --before api-reference/openapi-integrator.json --after https://api.byzantine.fi/api-docs/openapi-integrator.json --markdown-out /dev/stdout",
    "openapi:diff": "node scripts/analyze-openapi.mjs",
    "openapi:resolve-deployed": "node scripts/resolve-deployed-openapi.mjs",
    "delivery:queue": "node scripts/queue-delivery.mjs",
    "delivery:reconcile": "node scripts/reconcile-delivery.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
